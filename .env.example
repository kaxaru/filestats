# Скопировать в .env и поправить под окружение.
# Вложенные настройки задаются через двойное подчёркивание: СЕКЦИЯ__ПОЛЕ.

DATABASE_URL=postgresql+asyncpg://filestats:filestats@db:5432/filestats

POSTGRES_USER=filestats
POSTGRES_PASSWORD=filestats
POSTGRES_DB=filestats

# Порт, на котором сервис слушает снаружи. Поменяйте, если 80 уже занят.
WEB_PORT=80

# --- внешнее API каталога ---
CATALOG_API__BASE_URL=http://91.199.149.128:18001

# !!! ОБЯЗАТЕЛЬНО поменяйте на что-нибудь своё и уникальное.
#
# Каталог отдаёт каждый файл ровно один раз на идентификатор. Если взять
# чужой — уже использованный — то ручка имён сразу вернёт пустой список, обход
# завершится за секунду с нулём файлов, и это будет выглядеть как поломка,
# хотя сервис отработает правильно.
#
# Любая уникальная строка годится: имя, почта, случайные символы.
CATALOG_API__CANDIDATE_ID=поменяйте-меня-на-уникальное-значение

# --- подбор темпа (значения по умолчанию обычно менять не нужно) ---
# PACING__INITIAL_INTERVAL_SECONDS=1.0
# PACING__MIN_INTERVAL_SECONDS=0.35
# PACING__MAX_CONSECUTIVE_THROTTLES=20

# --- обход ---
# Сколько файлов накапливаем перед отметкой «скачано».
# DOWNLOAD__CONFIRM_BATCH_SIZE=30

# --- представление ---
# WEB__PAGE_SIZE=50
# WEB__DISPLAY_TIMEZONE=Asia/Novosibirsk

# --- логи ---
# json для машинной обработки, text — для чтения глазами при разработке.
# LOGGING__FORMAT=text
